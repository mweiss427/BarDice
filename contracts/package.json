{
  "name": "@bardice/contracts",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "hardhat build && node scripts/export-abi.mjs",
    "test": "hardhat test",
    "coverage": "hardhat test --coverage",
    "chain": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy-local.ts --network localhost",
    "vrf:autofulfill": "hardhat run scripts/vrf-autofulfill.ts --network localhost",
    "slither": "slither contracts/BarDice.sol --config-file slither.config.json",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^22.20.4",
    "hardhat": "^3.18.0",
    "typescript": "^5.9.3",
    "viem": "^2.57.1"
  }
}
