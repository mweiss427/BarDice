{
  "name": "bardice",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.10.0"
  },
  "scripts": {
    "compile": "pnpm --filter @bardice/contracts compile",
    "test": "pnpm -r test",
    "test:contracts": "pnpm --filter @bardice/contracts test",
    "test:web": "pnpm --filter @bardice/web test",
    "test:e2e": "pnpm --filter @bardice/web test:e2e",
    "chain": "pnpm --filter @bardice/contracts chain",
    "deploy:local": "pnpm --filter @bardice/contracts deploy:local",
    "dev": "pnpm --filter @bardice/web dev",
    "lint": "pnpm -r lint",
    "slither": "pnpm --filter @bardice/contracts slither"
  }
}
